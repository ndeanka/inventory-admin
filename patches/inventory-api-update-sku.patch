+  @Test
+  void updateReturnsChangedSku() throws Exception {
+    UUID id = UUID.randomUUID();
+    Instant now = Instant.parse("2026-01-15T10:00:00Z");
+    when(items.update(eq(id), any()))
+        .thenReturn(new ItemResponse(id, "SKU-200", "Renamed", 4, new BigDecimal("3.00"), now, now));
+
+    mockMvc
+        .perform(
+            put("/api/v1/items/{id}", id)
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(
+                    """
+                        {
+                          "sku": "SKU-200",
+                          "name": "Renamed",
+                          "quantityOnHand": 4,
+                          "unitPrice": 3.00
+                        }
+                        """))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.sku").value("SKU-200"))
+        .andExpect(jsonPath("$.name").value("Renamed"));
+  }
+
   @Test
   void duplicateSkuReturnsConflict() throws Exception {
     when(items.create(any())).thenThrow(new ConflictException("SKU already exists: SKU-DUP"));
