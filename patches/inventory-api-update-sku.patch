diff --git a/src/main/java/com/ndeanka/inventory/item/ItemService.java b/src/main/java/com/ndeanka/inventory/item/ItemService.java
index ecd77f6..ba2c138 100644
--- a/src/main/java/com/ndeanka/inventory/item/ItemService.java
+++ b/src/main/java/com/ndeanka/inventory/item/ItemService.java
@@ -46,6 +46,11 @@ public class ItemService {
   @CacheEvict(cacheNames = CACHE_ITEMS, key = "#id")
   public ItemResponse update(UUID id, UpdateItemRequest request) {
     Item item = require(id);
+    String sku = request.sku().trim().toUpperCase();
+    if (!sku.equals(item.getSku()) && items.existsBySku(sku)) {
+      throw new ConflictException("SKU already exists: " + sku);
+    }
+    item.changeSku(sku);
     item.rename(request.name().trim());
     item.adjustStock(request.quantityOnHand());
     item.reprice(request.unitPrice());
