+++ b/src/main/java/com/ndeanka/inventory/item/Item.java
@@ -86,6 +86,10 @@ public class Item {
     return updatedAt;
   }
 
+  public void changeSku(String sku) {
+    this.sku = sku;
+  }
+
   public void rename(String name) {
