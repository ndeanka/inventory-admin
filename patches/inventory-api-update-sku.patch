+  @Test
+  void updateChangesSkuWhenItIsFree() {
+    Item existing = new Item("SKU-100", "Name", 1, new BigDecimal("1.00"));
+    when(repository.findById(existing.getId())).thenReturn(Optional.of(existing));
+    when(repository.existsBySku("SKU-200")).thenReturn(false);
+    when(repository.save(any(Item.class))).thenAnswer(inv -> inv.getArgument(0));
+
+    ItemResponse response = service.update(
+        existing.getId(),
+        new UpdateItemRequest(" sku-200 ", "Renamed", 4, new BigDecimal("2.50")));
+
+    assertThat(response.sku()).isEqualTo("SKU-200");
+    assertThat(response.name()).isEqualTo("Renamed");
+    assertThat(response.quantityOnHand()).isEqualTo(4);
+  }
+
+  @Test
+  void updateKeepsTheSameSkuWithoutADuplicateCheck() {
+    Item existing = new Item("SKU-100", "Name", 1, new BigDecimal("1.00"));
+    when(repository.findById(existing.getId())).thenReturn(Optional.of(existing));
+    when(repository.save(any(Item.class))).thenAnswer(inv -> inv.getArgument(0));
+
+    ItemResponse response = service.update(
+        existing.getId(),
+        new UpdateItemRequest("sku-100", "Name", 1, new BigDecimal("1.00")));
+
+    assertThat(response.sku()).isEqualTo("SKU-100");
+    verify(repository, never()).existsBySku(any());
+  }
+
+  @Test
+  void updateRejectsDuplicateSku() {
+    Item existing = new Item("SKU-100", "Name", 1, new BigDecimal("1.00"));
+    when(repository.findById(existing.getId())).thenReturn(Optional.of(existing));
+    when(repository.existsBySku("SKU-200")).thenReturn(true);
+
+    assertThatThrownBy(
+        () -> service.update(
+            existing.getId(),
+            new UpdateItemRequest("SKU-200", "Name", 1, new BigDecimal("1.00"))))
+        .isInstanceOf(ConflictException.class)
+        .hasMessage("SKU already exists: SKU-200");
+  }
+
   @Test
   void getByIdRequiresExistingItem() {
     when(repository.findById(any())).thenReturn(Optional.empty());
